# Application Comptable - Environment Variables
# Copy this file to .env and customize values

# =============================================================================
# GENERAL SETTINGS
# =============================================================================

# Application environment: development, staging, production
ENVIRONMENT=development

# Debug mode (true/false) - NEVER enable in production
DEBUG=true

# Secret key for JWT tokens - GENERATE WITH: openssl rand -hex 32
# MUST be changed in production!
SECRET_KEY=your-super-secret-key-change-in-production-min-32-chars

# =============================================================================
# DATABASE (PostgreSQL)
# =============================================================================

POSTGRES_USER=app_user
POSTGRES_PASSWORD=change-me-in-production
POSTGRES_DB=app_db
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Full DATABASE_URL (auto-constructed if not set)
# DATABASE_URL=postgresql+asyncpg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}

# =============================================================================
# REDIS
# =============================================================================

REDIS_PASSWORD=change-me-in-production
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0

# Full REDIS_URL (auto-constructed if not set)
# REDIS_URL=redis://:${REDIS_PASSWORD}@${REDIS_HOST}:${REDIS_PORT}/${REDIS_DB}

# =============================================================================
# FILE STORAGE (MinIO / S3)
# =============================================================================

MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change-me-in-production
MINIO_BUCKET=app-files
MINIO_ENDPOINT=minio:9000
MINIO_USE_SSL=false

# For AWS S3 instead of MinIO:
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=us-east-1
# AWS_S3_BUCKET=app-files

# =============================================================================
# EMAIL (MailHog for dev, SMTP for prod)
# =============================================================================

# Development (MailHog)
MAILHOG_HOST=mailhog
MAILHOG_PORT=1025
MAILHOG_WEB_PORT=8025

# Production SMTP
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=noreply@example.com
# SMTP_PASSWORD=change-me
# SMTP_TLS=true
# EMAIL_FROM=noreply@example.com
# EMAIL_FROM_NAME=Application Comptable

# =============================================================================
# FRONTEND
# =============================================================================

NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NODE_ENV=development

# =============================================================================
# NGINX / SSL
# =============================================================================

# Domain for production
# DOMAIN=app.example.com

# SSL certificate paths (for production)
# SSL_CERT_PATH=/etc/nginx/ssl/app.example.com.crt
# SSL_KEY_PATH=/etc/nginx/ssl/app.example.com.key

# =============================================================================
# MONITORING (Grafana, Prometheus, Alertmanager)
# =============================================================================

GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me-in-production

# =============================================================================
# PGADMIN
# =============================================================================

PGADMIN_EMAIL=admin@example.com
PGADMIN_PASSWORD=change-me-in-production

# =============================================================================
# BACKUP SETTINGS
# =============================================================================

BACKUP_DIR=/backups
RETENTION_DAYS=30

# S3 Backup (optional)
# S3_BUCKET=app-backups
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=us-east-1

# MinIO Backup (optional)
# MINIO_BACKUP_ENDPOINT=minio:9000
# MINIO_BACKUP_ACCESS_KEY=minioadmin
# MINIO_BACKUP_SECRET_KEY=change-me

# =============================================================================
# CORS / SECURITY
# =============================================================================

# Allowed origins for CORS (comma-separated)
# BACKEND_CORS_ORIGINS=http://localhost:3000,http://localhost:8000

# Trusted hosts for production
# ALLOWED_HOSTS=app.example.com,api.example.com

# =============================================================================
# RATE LIMITING
# =============================================================================

# API rate limit (requests per second)
RATE_LIMIT_API=10

# Login rate limit (requests per minute)
RATE_LIMIT_LOGIN=5

# =============================================================================
# LOGGING
# =============================================================================

LOG_LEVEL=INFO
LOG_FORMAT=json