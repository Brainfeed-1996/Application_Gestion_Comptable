# Multi-stage build for production frontend
# Stage 1: Build dependencies
FROM node:20-alpine AS deps
WORKDIR /app

# Install libc for native modules
RUN apk add --no-cache libc6-compat

COPY package.json package-lock.json ./
RUN npm ci --legacy-peer-deps --ignore-scripts

# Stage 2: Build the application
FROM node:20-alpine AS builder
WORKDIR /app

# Install libc for native modules
RUN apk add --no-cache libc6-compat

COPY --from=deps /app/node_modules ./node_modules
COPY . .

# Build arguments
ARG NEXT_PUBLIC_API_URL
ARG NODE_ENV=production

ENV NEXT_PUBLIC_API_URL=${NEXT_PUBLIC_API_URL:-https://app.example.com/api/v1}
ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1

RUN npm run build

# Stage 3: Production runner with nginx
FROM nginx:alpine AS runner

# Install node for healthcheck
RUN apk add --no-cache nodejs

WORKDIR /app

# Copy built static files
COPY --from=builder /app/out ./html

# Copy nginx config
COPY docker/frontend/nginx.conf /etc/nginx/conf.d/default.conf

# Copy healthcheck script
COPY docker/frontend/healthcheck.sh /healthcheck.sh
RUN chmod +x /healthcheck.sh

# Optimize nginx
RUN echo "client_max_body_size 50M;" > /etc/nginx/nginx.conf && \
    echo "worker_processes auto;" >> /etc/nginx/nginx.conf && \
    echo "error_log /var/log/nginx/error.log warn;" >> /etc/nginx/nginx.conf && \
    echo "pid /var/run/nginx.pid;" >> /etc/nginx/nginx.conf && \
    echo "events { worker_connections 1024; }" >> /etc/nginx/nginx.conf && \
    echo "http {" >> /etc/nginx/nginx.conf && \
    echo "    include /etc/nginx/conf.d/*.conf;" >> /etc/nginx/nginx.conf && \
    echo "    default_type application/octet-stream;" >> /etc/nginx/nginx.conf && \
    echo "    sendfile on;" >> /etc/nginx/nginx.conf && \
    echo "    tcp_nopush on;" >> /etc/nginx/nginx.conf && \
    echo "    keepalive_timeout 65;" >> /etc/nginx/nginx.conf && \
    echo "    gzip on;" >> /etc/nginx/nginx.conf && \
    echo "    gzip_vary on;" >> /etc/nginx/nginx.conf && \
    echo "    gzip_min_length 1024;" >> /etc/nginx/nginx.conf && \
    echo "    gzip_types text/plain text/css text/xml text/javascript application/json application/javascript application/xml image/svg+xml font/woff font/woff2;" >> /etc/nginx/nginx.conf && \
    echo "}" >> /etc/nginx/nginx.conf

EXPOSE 80

HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
    CMD /healthcheck.sh

CMD ["nginx", "-g", "daemon off;"]