# =============================================================================
# Application Comptable - Production Environment Variables
# Copy this file to .env.production and customize values
# NEVER commit this file with real credentials!
# =============================================================================

# =============================================================================
# GENERAL SETTINGS
# =============================================================================

ENVIRONMENT=production
DEBUG=false
LOG_LEVEL=INFO
LOG_FORMAT=json

# Secret key for JWT tokens - GENERATE WITH: openssl rand -hex 32
SECRET_KEY=change-this-to-a-random-64-char-secret-key-in-production

# =============================================================================
# DATABASE (PostgreSQL)
# =============================================================================

POSTGRES_USER=accounting_prod_user
POSTGRES_PASSWORD=change-this-to-a-secure-production-password
POSTGRES_DB=accounting_prod
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Full DATABASE_URL (auto-constructed)
# DATABASE_URL=postgresql+asyncpg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}

# =============================================================================
# REDIS
# =============================================================================

REDIS_PASSWORD=change-this-to-a-secure-redis-password
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0

# =============================================================================
# FILE STORAGE (MinIO / S3)
# =============================================================================

MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change-this-to-a-secure-minio-password
MINIO_BUCKET=app-files
MINIO_ENDPOINT=minio:9000
MINIO_USE_SSL=false

# For AWS S3 instead of MinIO:
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=us-east-1
# AWS_S3_BUCKET=app-files

# =============================================================================
# EMAIL (SMTP for production)
# =============================================================================

SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=noreply@example.com
SMTP_PASSWORD=change-this-smtp-password
SMTP_TLS=true
SMTP_FROM=noreply@example.com
EMAIL_FROM_NAME=Application Comptable

# =============================================================================
# FRONTEND
# =============================================================================

DOMAIN=app.example.com
NEXT_PUBLIC_API_URL=https://app.example.com/api/v1
NODE_ENV=production

# =============================================================================
# CORS / SECURITY
# =============================================================================

# Allowed origins for CORS (comma-separated)
CORS_ORIGINS=https://app.example.com,https://www.app.example.com,https://api.app.example.com

# Trusted hosts for production
ALLOWED_HOSTS=app.example.com,api.app.example.com

# =============================================================================
# RATE LIMITING
# =============================================================================

# API rate limit (requests per second)
RATE_LIMIT_PER_MINUTE=60

# Login rate limit (requests per minute)
RATE_LIMIT_LOGIN_PER_MINUTE=10

# =============================================================================
# MONITORING (Sentry)
# =============================================================================

SENTRY_DSN=https://example@o0.ingest.sentry.io/0
SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_ENVIRONMENT=production

# =============================================================================
# PGADMIN
# =============================================================================

PGADMIN_EMAIL=admin@example.com
PGADMIN_PASSWORD=change-this-pgadmin-password

# =============================================================================
# BACKUP SETTINGS
# =============================================================================

BACKUP_DIR=/backups
RETENTION_DAYS=30